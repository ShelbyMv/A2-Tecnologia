# Base de datos — A2 Tecnología
# 
# Para desarrollo local temporal, descomenta y usa Postgres local.
# Para Vercel + Neon, pega la URL de Neon aquí.
#
# PostgreSQL connection string de Neon:
#   postgresql://USUARIO:CONTRASEÑA@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://neondb_owner:CONTRASENA@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Secreto para firmar la sesión de inicio de sesión.
# Genera uno con:  openssl rand -base64 32
AUTH_SECRET="cambia-esto-por-un-secreto-aleatorio-largo"
